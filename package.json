{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "backend:start": "cross-env PORT=3000 JWT_SECRET=devsecret ADMIN_API_BASE_URL=https://bulk-whatsapp-sender-desktopapp.onrender.com node backend/src/server.js",
    "backend:dev": "cross-env PORT=3000 JWT_SECRET=devsecret ADMIN_API_BASE_URL=https://bulk-whatsapp-sender-desktopapp.onrender.com node backend/src/server.js",
    "dev:full": "concurrently -k \"vite --port 8080 --host 127.0.0.1\" \"npm run backend:dev\"",
    "desktop:dev": "cross-env ELECTRON_DEV=true concurrently -k \"vite --port 8080 --host 127.0.0.1\" \"npm run backend:dev\" \"wait-on http://127.0.0.1:8080 http://127.0.0.1:3000/health && electron .\"",
    "desktop:build": "vite build && electron-builder -w",
    "desktop:pack": "vite build && electron-builder --dir"
  },
