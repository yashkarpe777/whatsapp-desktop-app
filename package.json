    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.brightcrest.whatsappblast",
    "productName": "WhatsApp Blast",
    "asar": true,
    "asarUnpack": [
      "node_modules/puppeteer-core/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/**/build/**",
      "node_modules/**/{*.node,*.dll}"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "node_modules/**",
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "src/**",
          "routes/**",
          "controllers/**",
          "middleware/**",
          "scripts/**",
          "config/**",
          "*.js",
          "*.mjs",
          ".env",
          "!**/.wwebjs_cache/**",
          "!uploads/**"
        ]
      },
      "electron/**",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/CHANGELOG*",
      "!**/CHANGELOG.*",
      "!**/changelog*",
      "!**/docs/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/example/**",
      "!**/examples/**",
      "!**/tests/**",
      "!**/.git/**",
      "!**/.vscode/**",
      "!**/screenshots/**"
    ],
    "extraResources": [
      { "from": "backend/uploads", "to": "backend/uploads", "filter": ["!**/*"] }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "compression": "maximum",
      "executableName": "WhatsAppBlast",
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": false
    }
  },
  "description": "Bulk whatsapp sender",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
